{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "PANDUAN.md",
      "README.md",
      ".git/**",
      ".github/**"
    ],
    "cleanUrls": true,
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
